[Unit]
Description=RISE pre-commit isolated single-job pilot

[Service]
Type=simple
WorkingDirectory=/srv/rise-precommit-ci
ExecStart=/usr/bin/podman run --rm --pull=never --name rise-precommit-07-pilot --userns=keep-id:uid=1001,gid=1001 --network=slirp4netns:allow_host_loopback=false --cpus=20 --memory=76g --pids-limit=8192 --cap-drop=ALL --security-opt=no-new-privileges --secret=runner-jit-config,uid=1001,gid=1001,mode=0400 --volume=/srv/rise-precommit-ci/diag:/opt/actions-runner/_diag localhost/rise-precommit-runner:20261117
ExecStop=/usr/bin/podman stop --ignore --time=900 rise-precommit-07-pilot
Restart=no
TimeoutStartSec=120
TimeoutStopSec=960
KillMode=mixed
UMask=0077

# Start only after installing a fresh JIT configuration. Do not enable at boot
# or restart after a completed job: JIT configurations are single-use.
